[Unit]
Description=Bind /dev/rfcomm0 til Brother PT-P300BT
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Bind er idempotent nok i praksis, men release forst gjor unitet trygt aa
# restarte uten aa faa "Can't create device: Address already in use".
ExecStartPre=-/usr/bin/rfcomm release 0
ExecStart=/usr/bin/rfcomm bind 0 98:6E:E8:4C:37:F8 1
ExecStop=-/usr/bin/rfcomm release 0

[Install]
WantedBy=multi-user.target
