[Unit]
Description=Caddy serving tyholtpizzeria.afrasum.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=afras
Group=afras
ExecStart=/usr/bin/caddy run --config /etc/caddy/tyholtpizzeria.Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
