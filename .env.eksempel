# Kopieres til .env paa rpi5. .env er git-ignorert.

# Admin-passord. Ett passord, alle bak disken bruker det samme.
TP_ADMIN_PASSORD=bytt-meg

# Signerer admin-informasjonskapselen. Lag en ny med:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TP_HEMMELIG_NOKKEL=bytt-meg-ogsaa

# Databasen ligger utenfor git-treet, med vilje.
TP_DB=/home/afras/data/tyholtpizzeria/base.db

# Etikettprinteren. Tom verdi slaar av printing (for utvikling paa Mac).
TP_PRINTER_PORT=/dev/rfcomm0

